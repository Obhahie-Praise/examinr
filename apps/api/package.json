{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate:local": "wrangler d1 migrations apply examinr-dev --local",
    "drizzle:migrate:remote": "wrangler d1 migrations apply examinr-dev --remote",
    "auth:migrate:local": "wrangler d1 execute examinr-dev --local --file=auth-migrations/0001_auth_schema.sql",
    "auth:migrate:remote": "wrangler d1 execute examinr-dev --remote --file=auth-migrations/0001_auth_schema.sql"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.12",
    "uploadthing": "^7.7.4"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.110.0"
  }
}